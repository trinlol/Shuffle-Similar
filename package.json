{
  "name": "shuffle-similar",
  "version": "2.0.0",
  "description": "Adaptive, source-resilient Similar Mix queues for Spicetify",
  "private": true,
  "scripts": {
    "build": "node esbuild.config.mjs",
    "build-local": "node esbuild.config.mjs --local",
    "build:release": "node esbuild.config.mjs --release",
    "generate:preview": "node scripts/generate-preview.mjs",
    "watch": "node esbuild.config.mjs --watch",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@types/react": "^18.3.12",
    "esbuild": "^0.28.2",
    "typescript": "^5.6.3",
    "vitest": "^4.1.10"
  }
}
